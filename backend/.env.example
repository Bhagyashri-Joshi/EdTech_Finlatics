# Copy this file to backend/.env for local development.
# Do not commit backend/.env.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Required: use a long random value in local/production environments.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Required: PostgreSQL connection string.
# This value cannot be generated from the source code.
# Add your Supabase/Neon/Render PostgreSQL URL here.
DATABASE_URL=
DATABASE_SSL=true

DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=125000
HEADERS_TIMEOUT_MS=130000

LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=10

# Optional AI integration. If empty, AI endpoints will report that Gemini is not configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
